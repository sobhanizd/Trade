# CryptoPilot AI — example environment file.
# Copy to `.env` and fill in values. NEVER commit real secrets.
# All variables are server-side only. Nothing here is ever sent to the browser
# except NEXT_PUBLIC_VAPID_PUBLIC_KEY (a public key by design).

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# PostgreSQL connection string.
DATABASE_URL=postgresql://cryptopilot:change-me@localhost:5432/cryptopilot
# Public base URL of the app (used in notification links and origin checks).
APP_URL=http://localhost:3000
# Random 32+ byte secret used to hash session tokens / IPs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-chars
# Session lifetime in days (sliding).
SESSION_TTL_DAYS=30
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Market data (all free/public; keys optional) ───────────────────────────
# Candle provider order. Supported: binance, kraken. First healthy wins.
CANDLE_PROVIDERS=binance,kraken
# Optional CoinGecko API key. Leave empty to use the keyless public API
# (low rate limit). A free "Demo" key raises limits.
COINGECKO_API_KEY=
# demo | pro  (pro uses pro-api.coingecko.com — paid)
COINGECKO_API_PLAN=demo
# Fear & Greed index from alternative.me (free, attribution required). true|false
SENTIMENT_ENABLED=true

# ── Worker / scheduler ─────────────────────────────────────────────────────
# Cron expression for market scans (default every 5 minutes).
SCAN_CRON="*/5 * * * *"
# Cron for market overview snapshot refresh (1 CoinGecko call per run + /global every 30 min).
SNAPSHOT_CRON="*/10 * * * *"
# Cron for news refresh.
NEWS_CRON="*/30 * * * *"
# Cron for housekeeping (retention, deferred notifications).
MAINTENANCE_CRON="17 * * * *"

# ── Notifications (all optional) ───────────────────────────────────────────
# Telegram: create a bot with @BotFather, paste its token here. The chat ID is
# configured per-user in Settings → Notifications.
TELEGRAM_BOT_TOKEN=

# Email via SMTP (any provider: Brevo, Resend SMTP, Mailgun, Gmail app password…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CryptoPilot AI <alerts@example.com>"

# Browser push (Web Push / VAPID). Generate with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Optional AI explainer ──────────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com). Leave empty to disable AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Effort for the explainer: low | medium | high (higher = deeper, slower, costlier)
ANTHROPIC_EFFORT=medium

# ── News (optional) ────────────────────────────────────────────────────────
# Comma-separated RSS feeds (headlines + links only are stored/shown).
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed
NEWS_ENABLED=true

# ── Docker Compose only ────────────────────────────────────────────────────
# Password for the bundled PostgreSQL container (compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=change-me-long-random
# Public domain for automatic HTTPS via Caddy (docker compose --profile https up -d)
DOMAIN=cryptopilot.example.com
